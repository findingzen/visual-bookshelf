{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git ls-files:*)",
      "Bash(ls:*)", "Bash(tree:*)", "Bash(wc:*)", "Bash(file:*)",
      "Bash(podman ps:*)", "Bash(podman images:*)",
      "Bash(podman compose ps:*)", "Bash(podman compose logs:*)",
      "Bash(podman compose build:*)", "Bash(podman compose up:*)",
      "Bash(podman compose restart:*)", "Bash(podman compose stop:*)",
      "Bash(docker compose ps:*)", "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./.env)", "Edit(./.env)",
      "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./visual-bookshelf)",
      "Read(~/.ssh/**)", "Edit(~/.ssh/**)",
      "Bash(cat .env:*)", "Bash(cat ~/.ssh:*)",
      "Bash(podman compose config:*)", "Bash(docker compose config:*)",
      "Bash(podman compose down -v:*)", "Bash(docker compose down -v:*)",
      "Bash(podman volume rm:*)", "Bash(podman volume prune:*)",
      "Bash(git push --force:*)", "Bash(git config --global:*)", "Bash(git remote set-url:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 30,
            "statusMessage": "Checking line endings and formatting"
          }
        ]
      }
    ]
  }
}

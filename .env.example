# happy-bookshelf configuration
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored;
# never commit it. Every variable the stack reads is documented here.

# ── Compose ───────────────────────────────────────────────
# Fixed name so containers, networks and volumes never collide with other
# projects on the same machine.
COMPOSE_PROJECT_NAME=happy-bookshelf

# ── Host ports (Caddy) ────────────────────────────────────
# Non-default, unprivileged ports: rootless Podman cannot bind below 1024,
# and 8080/443 are often taken by other projects.
HB_HTTPS_PORT=8443
HB_HTTP_PORT=8081

# Address the ports bind to on the host.
# 127.0.0.1 keeps the app private to this machine.
# 0.0.0.0 exposes it on the LAN, which phone scanning needs.
HB_BIND_ADDRESS=127.0.0.1

# Hostname Caddy serves and issues its certificate for: `localhost`, or the
# machine's LAN name or IP when testing from a phone.
HB_SITE_HOST=localhost

# ── Django ────────────────────────────────────────────────
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# `true` only in development.
DJANGO_DEBUG=false

# Comma-separated. Must include HB_SITE_HOST.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins, with scheme and port, e.g. https://localhost:8443
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443

# ── PostgreSQL ────────────────────────────────────────────
# Postgres is never published to the host; only `web` and `worker` reach it.
POSTGRES_DB=happy_bookshelf
POSTGRES_USER=happy_bookshelf
POSTGRES_PASSWORD=change-me
